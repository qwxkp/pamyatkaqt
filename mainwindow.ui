      <property name="styleSheet">
       <string notr="true">/* Верхняя панель навигации (месяц, год, стрелки) */
#qt_calendar_navigationbar {
    background-color: #2b2b2b; /* Цвет фона заголовка */
    min-height: 35px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

/* Кнопки переключения и выбора месяца/года */
QCalendarWidget QToolButton {
    color: #e0e0e0;
    background-color: transparent;
    font-size: 14px;
    font-weight: bold;
    margin: 2px;
    border-radius: 4px;
}

/* Эффект наведения для кнопок в заголовке */
QCalendarWidget QToolButton:hover {
    background-color: #404040;
}

/* Выпадающее меню выбора месяца */
QCalendarWidget QMenu {
    background-color: #2b2b2b;
    color: white;
}

/* Сетка с днями */
QCalendarWidget QAbstractItemView:enabled {
    background-color: #1e1e1e; /* Темный фон самой сетки */
    color: #e0e0e0;            /* Цвет текста дней */
    selection-background-color: #3a3a3a; /* Цвет фона выбранного дня */
    selection-color: #ffffff;            /* Цвет текста выбранного дня */
    outline: none; /* Убираем стандартную пунктирную рамку фокуса */
}

/* Дни из соседних месяцев (неактивные) */
QCalendarWidget QAbstractItemView:disabled {
    color: #555555;
}</string>
